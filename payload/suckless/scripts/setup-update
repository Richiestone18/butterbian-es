#!/bin/sh
# setup-update — pull the setup's repo and run its installer, from the
# folder install.sh was last run from (recorded in the state folder's
# shipped/). Nothing here runs on its own: the command menu's "Update
# setup" opens a terminal on it, and the update terminals ask once at the
# end whether the setup has moved on.
#   setup-update          pull (clone if the folder is gone), install, wait for enter
#   setup-update check    say how far behind the installed setup is; exit 0 if behind
#   setup-update offer    check, and ask y/N to update now
set -u
R="${XDG_STATE_HOME:-$HOME/.local/state}/suckless/shipped"
[ -f "$R/commit" ] || { echo "setup-update: no hay registro de instalación en $R (no se instaló desde un clon de git)"; exit 1; }
COMMIT=$(cat "$R/commit"); BRANCH=$(cat "$R/branch"); REMOTE=$(cat "$R/remote"); SRC=$(cat "$R/source")

# how many commits the remote branch is past the installed one: with the
# clone around it's a real count; without, only "the remote has moved"
check() {
    if [ -d "$SRC/.git" ]; then
        timeout 20 git -C "$SRC" fetch -q origin "$BRANCH" 2>/dev/null || { echo "setup: no se pudo alcanzar $REMOTE"; return 1; }
        n=$(git -C "$SRC" rev-list --count "$COMMIT..origin/$BRANCH" 2>/dev/null) || n=""
        case "$n" in
            ""|0) echo "setup: al día ($BRANCH)"; return 1 ;;
            1)    echo "setup: 1 commit más nuevo en $BRANCH" ;;
            *)    echo "setup: $n commits más nuevos en $BRANCH" ;;
        esac
    else
        head=$(timeout 20 git ls-remote "$REMOTE" "refs/heads/$BRANCH" 2>/dev/null | cut -f1)
        [ -n "$head" ] || { echo "setup: no se pudo alcanzar $REMOTE"; return 1; }
        [ "$head" != "$COMMIT" ] || { echo "setup: al día ($BRANCH)"; return 1; }
        echo "setup: $BRANCH avanzó desde esta instalación ($SRC ya no está, así que sin conteo)"
    fi
}

# a failure is said and returns, so the terminal stays open on it
update() {
    # the folder it came from, else ~/<its name> (a temporary clone's gone)
    [ -d "$SRC/.git" ] || SRC="$HOME/$(basename "$SRC")"
    if [ -d "$SRC/.git" ]; then
        echo "$SRC: bajando $BRANCH"
        git -C "$SRC" pull --ff-only origin "$BRANCH" \
            || { echo "falló la actualización: $SRC no pudo bajar origin/$BRANCH (git dice por qué arriba)"; return 1; }
    elif [ -e "$SRC" ]; then
        echo "falló la actualización: $SRC está en medio y no es un clon del setup"; return 1
    else
        echo "clonando $REMOTE ($BRANCH) en $SRC"
        git clone -q -b "$BRANCH" "$REMOTE" "$SRC" \
            || { echo "falló la actualización: no se pudo clonar $REMOTE"; return 1; }
    fi
    if ! (cd "$SRC" && ./install.sh --only-config); then
        echo "falló la actualización: el instalador se detuvo (ver arriba)"; return 1
    fi
}

case "${1:-}" in
    check) check ;;
    offer) check || exit 0
           printf '¿actualizar ahora? [y/N] '; read -r a
           case "$a" in y|Y) update ;; esac ;;
    "")    update && printf '\nlisto' ; printf '\npulsa enter para cerrar '; read -r _ ;;
    *)     echo "uso: setup-update [check|offer]"; exit 2 ;;
esac
