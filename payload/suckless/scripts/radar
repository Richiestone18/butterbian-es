#!/bin/bash
# radar LAT LON [ZOOM] — fetch the map tiles for the weather card's radar
# view and print where they are.
#
# Basemap: Esri's dark gray canvas (base + a separate labels layer, so
# the rain draws between land and names).
# Rain, inside the continental US: NOAA's own quality-checked radar
# mosaic (the conus_bref_qcd WMS layer), a frame every five minutes for
# the last hour plus the newest one. Anywhere else, or when NOAA doesn't
# answer: RainViewer's free worldwide mosaic, the last few 10-minute
# frames. Everything lands in the cache dir, base tiles for good, frames
# pruned as they age out; a second run for the same spot is mostly hits.
# Output, one item per line:
#   zoom Z
#   center X Y            fractional tile coordinates of LAT,LON
#   base DIR              DIR/Z_X_Y.jpg (land) and Z_X_Y_ref.png (labels)
#   source NAME           noaa or rainviewer
#   frame EPOCH DIR       oldest first
set -u

lat=${1:?lat}
lon=${2:?lon}
z=${3:-7}
cache=${XDG_CACHE_HOME:-$HOME/.cache}/suckless/radar
ua="butterdwm weather radar (https://justaguy.dev)"
noaa=https://opengeo.ncep.noaa.gov/geoserver/conus/conus_bref_qcd/ows

mkdir -p "$cache/base" || exit 1

# lat/lon -> fractional slippy-map tile coordinates at zoom z
read -r cx cy < <(awk -v lat="$lat" -v lon="$lon" -v z="$z" 'BEGIN {
    n = 2 ^ z; pi = atan2(0, -1); r = lat * pi / 180
    printf "%.4f %.4f\n", (lon + 180) / 360 * n, (1 - log(sin(r) / cos(r) + 1 / cos(r)) / pi) / 2 * n }')
ix=${cx%.*}; iy=${cy%.*}
n=$((1 << z))

# the frame list first: no rain data, no map. Lines of "epoch dir ref":
# ref is NOAA's timestamp or RainViewer's tile path.
src=""; list=""; host=""
if awk -v a="$lat" -v o="$lon" 'BEGIN { exit !(a >= 24 && a <= 50 && o >= -125.5 && o <= -66) }'; then
    # the layer's timestamps, about two minutes apart: the first in each
    # five-minute slot (the same pick on every run, so the cache holds),
    # the last twelve slots, then the newest of all
    times=$(curl -sf -m 10 -A "$ua" "$noaa?service=WMS&version=1.3.0&request=GetCapabilities" \
        | tr '\n' ' ' | sed -n 's/.*<Dimension name="time"[^>]*>\([^<]*\)<.*/\1/p' | tr ',' '\n')
    if [ -n "$times" ]; then
        list=$(while read -r iso; do
                   t=$(date -u -d "$iso" +%s 2>/dev/null) || continue
                   echo "$t $iso"
               done <<< "$times" | sort -n | awk '
                   { slot = int($1 / 300); if (slot != last) { pick[++k] = $0; last = slot } newest = $0 }
                   END { for (i = (k > 12 ? k - 11 : 1); i <= k; i++) print pick[i]
                         if (newest != pick[k]) print newest }' \
               | while read -r t iso; do echo "$t noaa-$t $iso"; done)
        [ -n "$list" ] && src=noaa
    fi
fi
if [ -z "$src" ]; then
    maps=$(curl -sf -m 10 -A "$ua" https://api.rainviewer.com/public/weather-maps.json) || {
        echo "radar: no se pudo conectar con RainViewer" >&2; exit 1; }
    host=$(printf '%s' "$maps" | sed -n 's/.*"host":"\([^"]*\)".*/\1/p')
    # past frames, newest last
    list=$(printf '%s' "$maps" | tr '{' '\n' | sed -n 's/"time":\([0-9]*\),"path":"\([^"]*\)".*/\1 \1 \2/p' | tail -n 6)
    [ -n "$list" ] || { echo "radar: sin imágenes" >&2; exit 1; }
    src=rainviewer
fi

# every tile we need, as curl arguments: fetch in parallel, only what's missing
args=()
for dy in -1 0 1; do
    for dx in -1 0 1; do
        x=$(( (ix + dx + n) % n )); y=$((iy + dy))
        [ "$y" -lt 0 ] || [ "$y" -ge "$n" ] && continue
        esri=https://server.arcgisonline.com/ArcGIS/rest/services/Canvas
        f="$cache/base/${z}_${x}_${y}.jpg"
        [ -s "$f" ] || args+=(-o "$f" "$esri/World_Dark_Gray_Base/MapServer/tile/$z/$y/$x")
        f="$cache/base/${z}_${x}_${y}_ref.png"
        [ -s "$f" ] || args+=(-o "$f" "$esri/World_Dark_Gray_Reference/MapServer/tile/$z/$y/$x")
        # the tile's corners in web mercator meters, for NOAA's WMS
        bbox=$(awk -v x="$x" -v y="$y" -v n="$n" 'BEGIN {
            r = 20037508.342789244; s = 2 * r / n
            printf "%.4f,%.4f,%.4f,%.4f", -r + x * s, r - (y + 1) * s, -r + (x + 1) * s, r - y * s }')
        while read -r t dir ref; do
            mkdir -p "$cache/$dir"
            f="$cache/$dir/${z}_${x}_${y}.png"
            [ -s "$f" ] && continue
            if [ "$src" = noaa ]; then
                args+=(-o "$f" "$noaa?service=WMS&version=1.1.1&request=GetMap&layers=conus_bref_qcd&styles=&format=image/png&transparent=true&srs=EPSG:3857&width=256&height=256&bbox=$bbox&time=$ref")
            else
                args+=(-o "$f" "$host$ref/256/$z/$x/$y/2/1_1.png")
            fi
        done <<< "$list"
    done
done
if [ "${#args[@]}" -gt 0 ]; then
    curl -sf -m 30 -Z --parallel-max 8 -A "$ua" "${args[@]}" || echo "radar: algunos mosaicos fallaron" >&2
fi

# frames older than the ones we keep
keep=$(printf '%s\n' "$list" | cut -d' ' -f2)
for d in "$cache"/[0-9]*/ "$cache"/noaa-*/; do
    [ -d "$d" ] || continue
    d=${d%/}
    grep -qx "${d##*/}" <<< "$keep" || rm -rf "$d"
done

echo "zoom $z"
echo "center $cx $cy"
echo "base $cache/base"
echo "source $src"
while read -r t dir _; do echo "frame $t $cache/$dir"; done <<< "$list"
