#!/bin/sh
# install-dwm — put the dwm the calling user just built (dwm, winshot, the
# man page) into /usr/local, as dwm's `make install` would. install.sh
# copies it to /usr/local/sbin/butterdwm-install-dwm, owned by root, and
# lets the user run it through sudo without a password: it takes no
# arguments, runs nothing from the user's folder, and copies only plain
# files that user owns, through a folder only root can write.
set -eu
u=${SUDO_USER:?run it through sudo}
uid=$(id -u "$u")
src=$(getent passwd "$u" | cut -d: -f6)/.config/suckless/dwm
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

for f in dwm winshot dwm.1; do
    if [ ! -f "$src/$f" ] || [ -L "$src/$f" ] || [ "$(stat -c %u "$src/$f")" != "$uid" ]; then
        echo "install-dwm: $src/$f no es un archivo normal de $u" >&2; exit 1
    fi
    cp -P "$src/$f" "$tmp/$f"
    if [ ! -f "$tmp/$f" ] || [ -L "$tmp/$f" ]; then
        echo "install-dwm: $src/$f cambió mientras se copiaba" >&2; exit 1
    fi
done
ver=$(sed -n 's/^VERSION = //p' "$src/config.mk" | tr -cd '0-9a-z.')

install -m755 "$tmp/dwm" /usr/local/bin/dwm
install -m755 "$tmp/winshot" /usr/local/bin/winshot
mkdir -p /usr/local/share/man/man1
sed "s/VERSION/$ver/g" "$tmp/dwm.1" > /usr/local/share/man/man1/dwm.1
chmod 644 /usr/local/share/man/man1/dwm.1
