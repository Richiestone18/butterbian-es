#!/bin/sh
# rules-gen — turn rules.conf into dwm/rules.h: the rules[] table
# config.def.h includes, plus the command array of every scratchpad.
# Run by the dwm Makefile whenever rules.conf changes.
#   rules-gen [rules.conf] > rules.h
# Errors (unknown field, bad tag, a scratch id used twice, a rule that
# matches nothing) go to stderr and nothing is written.
set -u
DIR="$(dirname "$(dirname "$(readlink -f "$0")")")"
CONF="${1:-$DIR/dwm/rules.conf}"
[ -r "$CONF" ] || { echo "rules-gen: no se pudo leer $CONF" >&2; exit 1; }

out=$(awk -v conf="$CONF" '
function die(msg) { printf "rules-gen: %s:%d: %s\n", conf, NR, msg > "/dev/stderr"; bad = 1 }
function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
function cesc(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); return s }
function cstr(s) { return s == "" ? "NULL" : "\"" cesc(s) "\"" }
function yesno(name, v) {
    if (v == "" || v == "no" || v == "0" || v == "false") return 0
    if (v == "yes" || v == "1" || v == "true") return 1
    die(name "= acepta yes o no"); return 0
}
function fields(line,   rest, name, val, c, i) {
    delete F
    rest = trim(line)
    while (rest != "") {
        if (match(rest, /^[a-z]+=/) == 0) { die("se espera name=value, en vez de \"" rest "\""); return 0 }
        name = substr(rest, 1, RLENGTH - 1); rest = substr(rest, RLENGTH + 1)
        c = substr(rest, 1, 1)
        if (c == "\"" || c == "\x27") {
            i = index(substr(rest, 2), c)
            if (i == 0) { die("comilla sin cerrar en " name "="); return 0 }
            val = substr(rest, 2, i - 1); rest = substr(rest, i + 2)
        } else {
            i = match(rest, /[ \t]/); val = i ? substr(rest, 1, i - 1) : rest; rest = i ? substr(rest, i) : ""
        }
        if (name !~ /^(class|instance|title|tag|float|center|monitor|scratch|run|desc)$/) { die("campo desconocido \"" name "\""); return 0 }
        if (name in F) { die("field " name "= repetido dos veces"); return 0 }
        F[name] = val
        rest = trim(rest)
    }
    return 1
}
function tagmask(v,   n, a, i, m) {
    if (v == "") return 0
    n = split(v, a, ","); m = 0
    for (i = 1; i <= n; i++) {
        if (a[i] !~ /^[0-9]+$/ || a[i] + 0 < 1 || a[i] + 0 > 12) { die("tag= quiere números 1-12, en vez de \"" v "\""); return 0 }
        m += 2 ^ (a[i] - 1)
    }
    return m
}
/^#[ \t]*---/ { s = $0; sub(/^#[ \t]*---[ \t]*/, "", s); sub(/[ \t]*---.*$/, "", s); nr++; row[nr] = "\t/* === " toupper(s) " === */"; next }
/^[ \t]*(#|$)/ { next }
{
    if (!fields($0)) next
    if (!("class" in F) && !("instance" in F) && !("title" in F)) { die("una regla necesita class=, instance= o title="); next }
    key = 0
    if ("scratch" in F) {
        id = F["scratch"]
        if (length(id) != 1 || id !~ /^[a-z]$/) die("scratch= es una letra minúscula")
        if (id in sdef) die("scratchpad " id " está definido dos veces")
        if (!("run" in F) || F["run"] == "") die("scratch= necesita run=, el comando que lo abre")
        sdef[id] = 1; ns++
        nw = split(F["run"], w, /[ \t]+/)
        line = "static const char *scratch_" id "[] = { \"" id "\""
        for (i = 1; i <= nw; i++) line = line ", \"" cesc(w[i]) "\""
        scratch[ns] = line ", NULL };"
        key = "\x27" id "\x27"
    } else if ("run" in F) die("run= solo va con scratch=")
    mon = ("monitor" in F && F["monitor"] != "") ? F["monitor"] : -1
    if (mon !~ /^-?[0-9]+$/) die("monitor= quiere un número")
    label = ("desc" in F && F["desc"] != "") ? F["desc"] : (F["class"] F["instance"] F["title"])
    gsub(/\*\//, "* /", label)
    nr++
    row[nr] = sprintf("\t{ %-14s %-14s %-12s %-6s %d, %d, %3d, %s },\t/* %s */",
        cstr(F["class"]) ",", cstr(F["instance"]) ",", cstr(F["title"]) ",", tagmask(F["tag"]) ",",
        yesno("float", F["float"]), yesno("center", F["center"]), mon, key, label)
}
END {
    if (bad) exit 1
    print "/* rules.h — GENERATED by scripts/rules-gen from rules.conf."
    print " * Edit rules.conf, not this file; Super+Escape or `make` regenerates it. */"
    print ""
    for (i = 1; i <= ns; i++) print scratch[i]
    if (ns) print ""
    print "static const Rule rules[] = {"
    print "\t/* class          instance       title        tags   isfloating, iscentered, monitor, scratchkey */"
    for (i = 1; i <= nr; i++) print row[i]
    print "\t/* the bar'\''s settings window (quickshell sets no WM_CLASS) */"
    print "\t{ NULL,          NULL,          \"butterdwm settings\", 0, 1, 1,  -1, 0 },"
    print "\t/* the nine tabbed scratch slots (scratchtagwins.c), Super+Alt+1..9 */"
    for (i = 1; i <= 9; i++) printf "\tSCRATCHTAGWIN_RULE (scratchtagwin%d, %d),\n", i, i
    print "};"
}' "$CONF") || exit 1
printf '%s\n' "$out"
