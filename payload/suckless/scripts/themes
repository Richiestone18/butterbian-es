#!/bin/sh
# themes — the themes the wallpaper picker offers beside "From wallpaper":
# a designed palette (Nord, Everforest...) in place of the one butterpal
# reads out of the image. They live in ~/.local/share/butter-themes/*.conf,
# one folder all the setups share; a file of your own there adds themes.
#
#   themes list                 one theme a line, tab-separated:
#                               id, name, wallpapers, the 24 colors
#   themes current              the theme in use; nothing while the colors
#                               come from the wallpaper
#   themes wallpaper            the wallpaper on screen
#   themes apply <id> [image]   the theme's colors on <image>, or on the
#                               wallpaper already up: a theme never changes
#                               the picture
#   themes off                  back to the colors of the wallpaper
#   themes forget               no theme in use any more, nothing recolored
#                               (the picker, as a new wallpaper brings its own)

set -u

CONFIG_DIR="$(dirname "$(dirname "$(readlink -f "$0")")")"
THEME_SCRIPT="$CONFIG_DIR/scripts/wallpaper-theme"
PICKED="$CONFIG_DIR/picked-theme"
WALLS="$CONFIG_DIR/wallpaper"
CURRENT="$CONFIG_DIR/wallpaper-current"
# the wallpaper up before any pick (autostart shows it)
DEFAULT="$WALLS/cozy-window.png"
THEMES="${XDG_DATA_HOME:-$HOME/.local/share}/butter-themes"

list() {
    cat "$THEMES"/*.conf 2>/dev/null | awk '
        function hexes(s, want,    n, a, i) {
            n = split(s, a, " ")
            if (n != want) return 0
            for (i = 1; i <= n; i++) if (a[i] !~ /^#[0-9a-fA-F]{6}$/) return 0
            return 1
        }
        function flush(    c) {
            if (id == "") return
            c = v["bg"] " " v["bg_alt"] " " v["fg"] " " v["border"] " " v["primary"] " " v["secondary"] " " v["alert"] " " v["disabled"]
            # a theme missing a color is left out, not half applied
            if (hexes(c, 8) && hexes(v["terminal"], 16))
                printf "%s\t%s\t%s\t%s %s\n", id, (v["name"] != "" ? v["name"] : id), v["wallpapers"], c, v["terminal"]
        }
        /^[ \t]*(#|$)/ { next }
        /^\[[A-Za-z0-9_-]+\][ \t]*$/ { flush(); id = $0; gsub(/[][ \t]/, "", id); split("", v); next }
        {
            k = $0; sub(/[ \t]*=.*/, "", k); gsub(/^[ \t]+/, "", k)
            val = $0; sub(/^[^=]*=[ \t]*/, "", val); sub(/[ \t]+$/, "", val)
            v[k] = val
        }
        END { flush() }'
}

# the wallpaper on screen: the one picked last, the default before any pick
current_image() {
    img=$(cat "$CURRENT" 2>/dev/null)
    [ -f "$img" ] || img="$DEFAULT"
    printf '%s\n' "$img"
}

case "${1:-}" in
    list) list ;;
    current) cat "$PICKED" 2>/dev/null ;;
    wallpaper) current_image ;;
    forget) rm -f "$PICKED" ;;
    apply)
        id="${2:-}"
        line=$(list | awk -F'\t' -v id="$id" '$1 == id { print; exit }')
        [ -n "$line" ] || { echo "themes: no hay tema $id en $THEMES" >&2; exit 1; }
        img="${3:-}"
        [ -n "$img" ] || img=$(current_image)
        if [ ! -f "$img" ]; then
            # no wallpaper up yet: the theme's own, the first of them in the folder
            for w in $(printf '%s\n' "$line" | cut -f3); do
                [ -f "$WALLS/$w" ] && { img="$WALLS/$w"; break; }
            done
        fi
        [ -f "$img" ] || { echo "themes: no hay fondo para $id" >&2; exit 1; }
        mkdir -p "$(dirname "$PICKED")"
        printf '%s\n' "$id" > "$PICKED"
        # shellcheck disable=SC2046  # 24 words, one color each
        exec "$THEME_SCRIPT" "$img" $(printf '%s\n' "$line" | cut -f4)
        ;;
    off)
        rm -f "$PICKED"
        img=$(current_image)
        [ -f "$img" ] || exit 0
        # shellcheck disable=SC2046
        exec "$THEME_SCRIPT" "$img" $(butterpal "$img")
        ;;
    *) echo "usage: themes list | current | wallpaper | forget | apply <id> [image] | off" >&2; exit 1 ;;
esac
